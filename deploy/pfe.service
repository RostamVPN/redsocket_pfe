[Unit]
Description=pfe XDP triangle-routing front-end
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/pfe/pfe.env
ExecStart=/usr/local/bin/pfe --iface ${PFE_IFACE} --mapfile /etc/pfe/map.csv --mode ${PFE_MODE} --queue ${PFE_QUEUE} --tunnel gre
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
# SIGHUP reloads routes atomically; SIGUSR1 dumps stats
KillSignal=SIGTERM
# bpf(2) needs CAP_BPF since Linux 5.8; the XDP attach CAP_NET_ADMIN; AF_XDP CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_BPF
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_BPF
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# AF_XDP + umem needs a chunk of locked memory
LimitMEMLOCK=infinity
Nice=-10

[Install]
WantedBy=multi-user.target
